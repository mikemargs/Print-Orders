# Database/authentication. For production, use the Supabase Postgres connection string.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
JWT_SECRET=replace-with-at-least-32-random-characters
APP_ENV=production

# Initial bootstrap (used only when the database has no company yet)
BOOTSTRAP_COMPANY_NAME=Print Operations
BOOTSTRAP_COMPANY_CODE=UPS-PRINT
BOOTSTRAP_COMPANY_PASSWORD=replace-me
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_PIN=replace-me

# Browser session security
WEB_COOKIE_SECURE=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# Artwork storage
STORAGE_BACKEND=supabase
MAX_UPLOAD_BYTES=262144000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_STORAGE_BUCKET=print-artwork

# Local/self-hosted Caddy address (Docker Compose only)
SITE_ADDRESS=https://orders.example.com

# Internal email notifications (Resend)
RESEND_API_KEY=re_xxxxxxxxx
NOTIFICATION_EMAIL_FROM=Print Order Manager <notifications@example.com>
NOTIFY_EMAIL_SAYVILLE=sayville@example.com
NOTIFY_EMAIL_SELDEN=selden@example.com
NOTIFY_EMAIL_MT_SINAI=mtsinai@example.com
NOTIFY_EMAIL_ADDITIONAL=
PUBLIC_APP_URL=https://orders.example.com
